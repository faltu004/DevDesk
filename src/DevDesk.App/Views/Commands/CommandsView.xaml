<UserControl x:Class="DevDesk.App.Views.Commands.CommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Commands"
             xmlns:cmd="clr-namespace:DevDesk.Core.Commands;assembly=DevDesk.Core"
             d:DataContext="{d:DesignInstance Type=vm:CommandsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{DynamicResource Brush.Background.Main}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <!-- 0: Header & Search -->
            <RowDefinition Height="Auto" />
            <!-- 1: Toolbar (Scope Tabs, Filters, Add Button) -->
            <RowDefinition Height="Auto" />
            <!-- 2: Error Banner -->
            <RowDefinition Height="Auto" />
            <!-- 3: Main Content (List/Groups + Details Inspector) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 0. HEADER & SEARCH ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Commands"
                           Style="{StaticResource Style.Text.Title}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="Save, organize, and run common development commands."
                           Style="{StaticResource Style.Text.Caption}"
                           FontSize="12.5"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Top Search Box (matches mockups) -->
            <Border Grid.Column="1"
                    Width="320"
                    Height="36"
                    CornerRadius="8"
                    Background="{DynamicResource Brush.Background.Input}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Width="13" Height="13"
                          Stretch="Uniform"
                          Fill="{DynamicResource Brush.Text.Muted}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />

                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             FontSize="12"
                             VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="Search commands, projects, tags..."
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="12"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Grid.Column="2"
                            Background="#1E293B"
                            CornerRadius="4"
                            Padding="5,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="Ctrl + K"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 1. TOOLBAR ==================== -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Scope Tabs (Project Commands / Global Commands) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="📁  Project Commands"
                                 IsChecked="{Binding IsProjectScopeSelected, Mode=OneWay}"
                                 Command="{Binding SelectScopeCommand}"
                                 CommandParameter="{x:Static vm:CommandScopeFilter.ProjectCommands}"
                                 Style="{StaticResource Style.Button.Nav}"
                                 Padding="12,6"
                                 Height="32"
                                 FontSize="12.5"
                                 FontWeight="SemiBold"
                                 Margin="0,0,4,0" />

                    <RadioButton Content="🌐  Global Commands"
                                 IsChecked="{Binding IsGlobalScopeSelected, Mode=OneWay}"
                                 Command="{Binding SelectScopeCommand}"
                                 CommandParameter="{x:Static vm:CommandScopeFilter.GlobalCommands}"
                                 Style="{StaticResource Style.Button.Nav}"
                                 Padding="12,6"
                                 Height="32"
                                 FontSize="12.5"
                                 FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Center Filters (Project & Category) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding AvailableProjects}"
                          SelectedItem="{Binding SelectedProjectFilter}"
                          Style="{StaticResource Style.ComboBox.Dark}"
                          Visibility="{Binding IsProjectScopeSelected, Converter={StaticResource BoolToVis}}"
                          Height="34"
                          Width="160"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />

                <ComboBox ItemsSource="{Binding AvailableCategories}"
                          SelectedItem="{Binding SelectedCategoryFilter}"
                          Style="{StaticResource Style.ComboBox.Dark}"
                          Height="34"
                          Width="150"
                          VerticalAlignment="Center" />
            </StackPanel>

            <!-- Action: + Add Command -->
            <Button Grid.Column="2"
                    Content="+ Add Command"
                    Command="{Binding AddCommandCommand}"
                    Style="{StaticResource Style.Button.Primary}"
                    Height="36"
                    Padding="16,0"
                    FontWeight="SemiBold" />
        </Grid>

        <!-- ==================== 2. ERROR BANNER ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Status.Danger.Bg}"
                BorderBrush="{DynamicResource Brush.Status.Danger.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage, Converter={x:Null}}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource Style.Ellipse.StatusDot.Danger}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Brush.Status.Danger}"
                           FontSize="12"
                           FontWeight="Medium" />
            </StackPanel>
        </Border>

        <!-- ==================== 3. MAIN SPLIT VIEW ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="460" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: COMMANDS LIST / GROUPS -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredCommands.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Width="36" Height="36" Stretch="Uniform"
                              Fill="{DynamicResource Brush.Text.Muted}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,12"
                              Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zm-12-3l4-3-4-3v2H6v2h2v2zm6 0h4v-2h-4v2z" />
                        <TextBlock Text="No saved commands found"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Create a new command or adjust search filters."
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,4,0,16"
                                   HorizontalAlignment="Center" />
                        <Button Content="+ Add Command"
                                Command="{Binding AddCommandCommand}"
                                Style="{StaticResource Style.Button.Primary}"
                                Height="34"
                                Padding="16,0"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Commands List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredCommands.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <ItemsControl ItemsSource="{Binding FilteredCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SavedCommandItemViewModel}">
                                    <Border Margin="0,0,0,8"
                                            Padding="14,10"
                                            CornerRadius="6"
                                            Background="{DynamicResource Brush.Background.CardSubtle}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Name, Description, Badges, Command Line -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="Bold"
                                                               FontSize="13.5"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />

                                                    <!-- Scope / Project Badge -->
                                                    <Border Background="#1E293B"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProjectName}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.Accent.Light}" />
                                                    </Border>

                                                    <!-- Category Badge -->
                                                    <Border Background="#1A2536"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Category}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Category}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Description if present -->
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                                           Margin="0,0,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Command Line Monospace preview -->
                                                <TextBlock Text="{Binding DisplayCommandLine}"
                                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Right: Status & Actions -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <!-- Status / Last Run -->
                                                <Border Background="{Binding StatusBadgeBackground}"
                                                        CornerRadius="4"
                                                        Padding="8,3"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LastRunText}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="{Binding StatusBadgeForeground}" />
                                                </Border>

                                                <!-- Run Button -->
                                                <Button Content="Run"
                                                        Command="{Binding DataContext.RunCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanRun}"
                                                        Height="28"
                                                        Padding="10,0"
                                                        Margin="0,0,6,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Action}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Stop Button -->
                                                <Button Content="Stop"
                                                        Command="{Binding DataContext.StopCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding CanStop}"
                                                        Height="28"
                                                        Padding="10,0"
                                                        Margin="0,0,6,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Style.Button.DangerOutline}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Edit Button -->
                                                <Button Content="Edit"
                                                        Command="{Binding DataContext.EditCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource Style.Button.Action}"
                                                        Height="28"
                                                        Padding="8,0"
                                                        Margin="0,0,4,0" />

                                                <!-- Delete Button -->
                                                <Button Content="✕"
                                                        Command="{Binding DataContext.DeleteCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource Style.Button.Action}"
                                                        Height="28"
                                                        Width="28"
                                                        Padding="0"
                                                        ToolTip="Delete Command" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: COMMAND DETAILS INSPECTOR & RECENT OUTPUT -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <Grid>
                    <!-- No Selection State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedCommand}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Select a command to inspect details and live output."
                                   FontSize="13"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Details Content -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedCommand}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Action Bar -->
                            <RowDefinition Height="Auto" />
                            <!-- Metadata Rows -->
                            <RowDefinition Height="Auto" />
                            <!-- Recent Output Section -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="{Binding SelectedCommand.Name}"
                                       Style="{StaticResource Style.Text.Title}"
                                       FontSize="18"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedCommand.Description}"
                                       Style="{StaticResource Style.Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Action Bar -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Run Command"
                                    Command="{Binding RunCommandCommand}"
                                    CommandParameter="{Binding SelectedCommand}"
                                    IsEnabled="{Binding SelectedCommand.CanRun}"
                                    Style="{StaticResource Style.Button.Action}"
                                    Height="32"
                                    Padding="14,0"
                                    Margin="0,0,8,0" />

                            <Button Content="Stop"
                                    Command="{Binding StopCommandCommand}"
                                    CommandParameter="{Binding SelectedCommand}"
                                    IsEnabled="{Binding SelectedCommand.CanStop}"
                                    Style="{StaticResource Style.Button.DangerOutline}"
                                    Height="32"
                                    Padding="14,0"
                                    Margin="0,0,8,0" />

                            <Button Content="Edit"
                                    Command="{Binding EditCommandCommand}"
                                    CommandParameter="{Binding SelectedCommand}"
                                    Style="{StaticResource Style.Button.Action}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,8,0" />

                            <Button Content="Delete"
                                    Command="{Binding DeleteCommandCommand}"
                                    CommandParameter="{Binding SelectedCommand}"
                                    Style="{StaticResource Style.Button.DangerOutline}"
                                    Height="32"
                                    Padding="12,0" />
                        </StackPanel>

                        <!-- Metadata Grid -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource Brush.Background.CardSubtle}"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Scope" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedCommand.ProjectName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Command" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedCommand.DisplayCommandLine}"
                                               FontFamily="{StaticResource FontFamily.Monospace}"
                                               FontSize="11.5" Foreground="{DynamicResource Brush.Accent.Light}"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Work Directory" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedCommand.WorkingDirectory}"
                                               FontFamily="{StaticResource FontFamily.Monospace}"
                                               FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Status" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedCommand.LastRunText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding SelectedCommand.StatusBadgeForeground}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Recent Output Section -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Recent Output"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Content="Copy"
                                        Command="{Binding CopyOutputCommand}"
                                        Style="{StaticResource Style.Button.Action}"
                                        Height="24"
                                        Padding="8,0"
                                        FontSize="11"
                                        Margin="0,0,6,0" />

                                <Button Grid.Column="2"
                                        Content="Clear"
                                        Command="{Binding ClearOutputCommand}"
                                        Style="{StaticResource Style.Button.Action}"
                                        Height="24"
                                        Padding="8,0"
                                        FontSize="11" />
                            </Grid>

                            <!-- Terminal Console Box -->
                            <Border Grid.Row="1"
                                    Background="#080C14"
                                    BorderBrush="#1E293B"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsControl ItemsSource="{Binding RecentOutputLines}">
                                         <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type cmd:SavedCommandOutputEvent}">
                                                <TextBlock Text="{Binding Text}"
                                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                                           FontSize="11.5"
                                                           LineHeight="16"
                                                           TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#CBD5E1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F87171" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
