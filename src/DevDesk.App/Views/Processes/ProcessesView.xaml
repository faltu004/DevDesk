<UserControl x:Class="DevDesk.App.Views.Processes.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Processes"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ProcessesViewModel}"
             d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Row Item Container Style for Data Table -->
        <Style x:Key="Style.ListBoxItem.ProcessRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush.Background.CardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Table Column Header Button Style -->
        <Style x:Key="Style.Button.TableHeader" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Outer Padding -->
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <!-- 0: Header & Search Bar -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <!-- 1: Top 4 Metric Summary Cards -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <!-- 2: Toolbar (Filters & Refresh) -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <!-- 3: Main Processes Table Card -->
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="16" />
            <!-- 4: Process Details Panel -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 0: HEADER & SEARCH ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource Style.Text.Header}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding Subtitle}"
                           Style="{StaticResource Style.Text.Caption}"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Search Bar -->
            <Border Grid.Column="1"
                    Style="{StaticResource Style.Border.Card}"
                    Background="{DynamicResource Brush.Background.Input}"
                    BorderBrush="{DynamicResource Brush.Border.Medium}"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Width="14" Height="14" Stretch="Uniform"
                          Fill="{DynamicResource Brush.Text.Muted}"
                          Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center" />

                    <Grid Grid.Column="1">
                        <TextBlock Text="Filter processes, PID, projects..."
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   FontSize="12"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderThickness="0"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource Brush.Text.Primary}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 1: TOP 4 METRIC SUMMARY CARDS ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 0: Observed Processes -->
            <Border Grid.Column="0"
                    Style="{StaticResource Style.Border.Card}"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Observed Processes"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center" />
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Brush.Accent.Light}"
                              HorizontalAlignment="Right"
                              Data="M12 15.5A3.5 3.5 0 0 1 8.5 12 3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5 3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97 0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1 0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66z" />
                    </Grid>
                    <TextBlock Text="{Binding ObservedProcessesCount}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="Active system &amp; developer processes"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 1: DevDesk Managed -->
            <Border Grid.Column="2"
                    Style="{StaticResource Style.Border.Card}"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="DevDesk Managed"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center" />
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Brush.Status.Success}"
                              HorizontalAlignment="Right"
                              Data="M12 2l-5.5 9h11z M12 22l5.5-9h-11z" />
                    </Grid>
                    <TextBlock Text="{Binding DevDeskManagedCount}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Status.Success}" />
                    <TextBlock Text="Processes started by DevDesk"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: Sampled Process CPU -->
            <Border Grid.Column="4"
                    Style="{StaticResource Style.Border.Card}"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Sampled Process CPU"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center" />
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Brush.Accent.Light}"
                              HorizontalAlignment="Right"
                              Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z" />
                    </Grid>
                    <TextBlock Text="{Binding SampledCpuText}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="Across processes with available CPU samples"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Combined Working Set -->
            <Border Grid.Column="6"
                    Style="{StaticResource Style.Border.Card}"
                    Background="{DynamicResource Brush.Background.Card}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Combined Working Set"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center" />
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Fill="{DynamicResource Brush.Text.Muted}"
                              HorizontalAlignment="Right"
                              Data="M2 4h20v4H2zm0 6h20v4H2zm0 6h20v4H2z" />
                    </Grid>
                    <TextBlock Text="{Binding CombinedWorkingSetText}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="Sum of visible process working sets"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 2: TOOLBAR (FILTERS & REFRESH) ==================== -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Filter Mode Selector (ComboBox Dark) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filter:"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,0,8,0" />
                <ComboBox SelectedIndex="{Binding FilterModeIndex, Mode=TwoWay}"
                          Style="{StaticResource Style.ComboBox.Dark}"
                          Width="160" Height="30">
                    <ComboBoxItem Content="All" IsSelected="True" />
                    <ComboBoxItem Content="DevDesk Managed" />
                    <ComboBoxItem Content="External" />
                </ComboBox>
            </StackPanel>

            <!-- Refresh Button -->
            <Button Grid.Column="2"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Style.Button.Action}"
                    Height="30"
                    Padding="14,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Stretch="Uniform"
                          Fill="{DynamicResource Brush.Text.Primary}"
                          Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                          Margin="0,0,6,0" />
                    <TextBlock Text="Refresh" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== 3: MAIN PROCESSES TABLE CARD ==================== -->
        <Border Grid.Row="6"
                Style="{StaticResource Style.Border.Card}"
                Background="{DynamicResource Brush.Background.Card}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Table Header Row -->
                    <RowDefinition Height="38" />
                    <!-- Table Body List -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Row -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Background.NavActive}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" MinWidth="180" /> <!-- Process Name -->
                            <ColumnDefinition Width="85" MinWidth="70" />   <!-- PID -->
                            <ColumnDefinition Width="95" MinWidth="80" />   <!-- CPU % -->
                            <ColumnDefinition Width="120" MinWidth="95" />  <!-- Memory (Working Set) -->
                            <ColumnDefinition Width="95" MinWidth="75" />   <!-- Started -->
                            <ColumnDefinition Width="140" MinWidth="120" /> <!-- Ownership -->
                            <ColumnDefinition Width="*" MinWidth="90" />    <!-- Status -->
                        </Grid.ColumnDefinitions>

                        <!-- Process Name Header (Sortable) -->
                        <Button Grid.Column="0"
                                Command="{Binding SetSortCommand}"
                                CommandParameter="Name"
                                Style="{StaticResource Style.Button.TableHeader}">
                            <TextBlock Text="Process" FontSize="11" FontWeight="SemiBold" />
                        </Button>

                        <!-- PID Header (Sortable) -->
                        <Button Grid.Column="1"
                                Command="{Binding SetSortCommand}"
                                CommandParameter="Pid"
                                Style="{StaticResource Style.Button.TableHeader}">
                            <TextBlock Text="PID" FontSize="11" FontWeight="SemiBold" />
                        </Button>

                        <!-- CPU % Header (Sortable) -->
                        <Button Grid.Column="2"
                                Command="{Binding SetSortCommand}"
                                CommandParameter="Cpu"
                                Style="{StaticResource Style.Button.TableHeader}">
                            <TextBlock Text="CPU %" FontSize="11" FontWeight="SemiBold" />
                        </Button>

                        <!-- Memory (Working Set) Header (Sortable) -->
                        <Button Grid.Column="3"
                                Command="{Binding SetSortCommand}"
                                CommandParameter="Memory"
                                Style="{StaticResource Style.Button.TableHeader}">
                            <TextBlock Text="Memory" FontSize="11" FontWeight="SemiBold" />
                        </Button>

                        <TextBlock Grid.Column="4" Text="Started" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Ownership" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Process List (Virtualized) -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredProcesses}"
                         SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource Style.ListBoxItem.ProcessRow}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProcessItemPresentationModel}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" MinWidth="180" /> <!-- Process Name -->
                                    <ColumnDefinition Width="85" MinWidth="70" />   <!-- PID -->
                                    <ColumnDefinition Width="95" MinWidth="80" />   <!-- CPU % -->
                                    <ColumnDefinition Width="120" MinWidth="95" />  <!-- Working Set -->
                                    <ColumnDefinition Width="95" MinWidth="75" />   <!-- Started -->
                                    <ColumnDefinition Width="140" MinWidth="120" /> <!-- Ownership -->
                                    <ColumnDefinition Width="*" MinWidth="90" />    <!-- Status -->
                                </Grid.ColumnDefinitions>

                                <!-- Process Name -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" CornerRadius="4"
                                            Background="{DynamicResource Brush.Background.NavActive}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="⚙" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding ProcessName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- PID -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProcessId}"
                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           VerticalAlignment="Center" />

                                <!-- CPU % -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding FormattedCpu}"
                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                           FontSize="12"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHighCpu}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Memory (Working Set) -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding FormattedWorkingSet}"
                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           VerticalAlignment="Center" />

                                <!-- Started -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding FormattedStartTime}"
                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           VerticalAlignment="Center" />

                                <!-- Ownership Badge -->
                                <Border Grid.Column="5"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsManaged}" Value="True">
                                                    <Setter Property="Background" Value="#1A2E26" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding OwnershipBadgeText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManaged}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ManagedProjectName, StringFormat=' ({0})'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManaged}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Status / Responding -->
                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{DynamicResource Brush.Status.Success}"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FormattedResponding, StringFormat=' • {0}'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FormattedResponding}" Value="—">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ==================== 4: PROCESS DETAILS PANEL ==================== -->
        <Border Grid.Row="8"
                Background="{DynamicResource Brush.Background.Card}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                Padding="16,12">
            <Border.Style>
                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Style.Border.Card}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedProcess}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid DataContext="{Binding SelectedProcess}">
                <Grid.ColumnDefinitions>
                    <!-- Left: Process Summary & Actions -->
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="20" />
                    <!-- Center: Metrics Grid -->
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="20" />
                    <!-- Right: Executable Path & Info -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ProcessName}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   VerticalAlignment="Center" />
                        <Border Background="#1A2E26"
                                BorderBrush="{DynamicResource Brush.Status.Success}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Status.Success}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding DataContext.CopyPidCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Style.Button.Action}"
                                Height="26" Padding="10,0" Margin="0,0,8,0">
                            <TextBlock Text="Copy PID" FontSize="11" />
                        </Button>
                        <Button Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource Style.Button.Action}"
                                Height="26" Padding="10,0">
                            <TextBlock Text="Open Location" FontSize="11" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Center Column: Key Metrics -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="PID" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding ProcessId}" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="CPU" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding FormattedCpu}" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Working Set" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding FormattedWorkingSet}" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4,0,0">
                        <TextBlock Text="Started" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding FormattedStartTime}" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <TextBlock Text="DevDesk Project" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding ManagedProjectName, TargetNullValue='None (External)'}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>
                </Grid>

                <!-- Right Column: Executable Path & Read-only banner -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="Executable Path" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,3" />
                    <Border Background="{DynamicResource Brush.Background.Input}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,5">
                        <TextBlock Text="{Binding ExecutablePath, TargetNullValue='— (Inaccessible or elevated)'}"
                                   FontFamily="{StaticResource FontFamily.Monospace}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TextBlock Text="DevDesk Process Inspector (Read-only)"
                               FontSize="10"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
