<UserControl x:Class="DevDesk.App.Views.Dashboard.DashboardView"
             x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Dashboard"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="880" d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="Style.ContextMenu.Dark" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,4" />
        </Style>
        <Style x:Key="Style.MenuItem.Dark" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,24,30,28">
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- 1: Spacing -->
                <RowDefinition Height="20" />
                <!-- 2: System Metrics Row -->
                <RowDefinition Height="Auto" />
                <!-- 3: Spacing -->
                <RowDefinition Height="20" />
                <!-- 4: Active Projects & Dev Environment Row -->
                <RowDefinition Height="Auto" />
                <!-- 5: Spacing -->
                <RowDefinition Height="20" />
                <!-- 6: Recent Projects & Quick Actions Row -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== 0: HEADER SECTION ==================== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource Style.Text.Header}"
                               FontSize="27"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle}"
                               Style="{StaticResource Style.Text.Subtitle}"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Right: Real Search Box -->
                <Border Grid.Column="1"
                        Style="{StaticResource Style.Border.Search}"
                        Width="370"
                        Height="38"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon / Submit Button -->
                        <Button Grid.Column="0"
                                Command="{Binding SubmitSearchCommand}"
                                Style="{StaticResource Style.Button.IconGhost}"
                                Width="26" Height="26"
                                Margin="0,0,6,0"
                                ToolTip="Search projects">
                            <Path Width="13" Height="13"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource Brush.Text.Muted}"
                                  Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                        </Button>

                        <!-- Search Input -->
                        <TextBox Grid.Column="1"
                                 x:Name="DashboardSearchTextBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderThickness="0"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource Brush.Text.Primary}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SubmitSearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Placeholder Text when empty -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SearchPlaceholder}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Style.Text.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Ctrl + K Badge -->
                        <Border Grid.Column="2"
                                Style="{StaticResource Style.Border.ShortcutBadge}">
                            <TextBlock Text="{Binding SearchShortcut}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 2: SYSTEM METRICS ROW ==================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Metric 1: CPU -->
                <Border Grid.Column="0" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Icon + Title -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="7"
                                        Background="#102744"
                                        BorderBrush="#1D436C"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M4 6h2v2H4zm0 5h2v2H4zm0 5h2v2H4zm14-10h2v2h-2zm0 5h2v2h-2zm0 5h2v2h-2zM6 4h2v2H6zm5 0h2v2h-2zm5 0h2v2h-2zM6 18h2v2H6zm5 0h2v2h-2zm5 0h2v2h-2zM7 7h10v10H7z" />
                                </Border>
                                <TextBlock Text="CPU"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding CpuValue}"
                                   Style="{StaticResource Style.Text.Header}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,10,0,6" />

                        <!-- Subtext + Sparkline Curve -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding CpuSubtext}"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center" />
                            <!-- Smooth Wave Sparkline -->
                            <Polyline Points="{Binding CpuSparklinePoints}"
                                      Stroke="{DynamicResource Brush.Accent.Light}"
                                      StrokeThickness="1.75"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Width="56" Height="18" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Metric 2: RAM -->
                <Border Grid.Column="2" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Icon + Title -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="7"
                                        Background="#0A2922"
                                        BorderBrush="#155144"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Teal}"
                                          Data="M4 7h16v10H4zm2 2v6h2V9zm4 0v6h2V9zm4 0v6h2V9z" />
                                </Border>
                                <TextBlock Text="RAM"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding RamValue}"
                                   Style="{StaticResource Style.Text.Header}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,10,0,6" />

                        <!-- Subtext + Progress Bar -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding RamSubtext}"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center" />
                            <!-- Mini Gauge Bar -->
                            <Border Width="76" Height="6" CornerRadius="3"
                                    Background="{DynamicResource Brush.Background.Input}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <Border Width="{Binding RamProgressWidth}" Height="6" CornerRadius="3"
                                        Background="{DynamicResource Brush.Status.Success}"
                                        HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Metric 3: Storage (Truthful Disk Space) -->
                <Border Grid.Column="4" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Icon + Title -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="7"
                                        Background="#182334"
                                        BorderBrush="#293952"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                          Data="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zm14 7a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" />
                                </Border>
                                <TextBlock Text="Storage"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding StorageValue}"
                                   Style="{StaticResource Style.Text.Header}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,10,0,6" />

                        <!-- Subtext + Progress Bar -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding StorageSubtext}"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center" />
                            <!-- Mini Gauge Bar -->
                            <Border Width="76" Height="6" CornerRadius="3"
                                    Background="{DynamicResource Brush.Background.Input}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <Border Width="{Binding StorageProgressWidth}" Height="6" CornerRadius="3"
                                        Background="{DynamicResource Brush.Status.Warning}"
                                        HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Metric 4: Network -->
                <Border Grid.Column="6" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Icon + Title -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="7"
                                        Background="#102744"
                                        BorderBrush="#1D436C"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98C20.93 5.9 16.69 4 12 4zm0 3.5c3.67 0 7.02 1.4 9.53 3.73l-2.07 2.08C17.47 11.66 14.86 10.5 12 10.5s-5.47 1.16-7.46 2.81L2.47 11.23C4.98 8.9 8.33 7.5 12 7.5z" />
                                </Border>
                                <TextBlock Text="Network"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding NetworkValue}"
                                   Style="{StaticResource Style.Text.Header}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,10,0,6" />

                        <!-- Subtext + Histogram Bars -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="{Binding NetworkSubtext}"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center" />
                            <!-- Mini Histogram -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom">
                                <Border Width="3.5" Height="{Binding NetworkBar1Height}" Background="{DynamicResource Brush.Accent.Light}" CornerRadius="1" Margin="1,0" />
                                <Border Width="3.5" Height="{Binding NetworkBar2Height}" Background="{DynamicResource Brush.Accent.Light}" CornerRadius="1" Margin="1,0" />
                                <Border Width="3.5" Height="{Binding NetworkBar3Height}" Background="{DynamicResource Brush.Accent.Light}" CornerRadius="1" Margin="1,0" />
                                <Border Width="3.5" Height="{Binding NetworkBar4Height}" Background="{DynamicResource Brush.Accent.Light}" CornerRadius="1" Margin="1,0" />
                                <Border Width="3.5" Height="{Binding NetworkBar5Height}" Background="{DynamicResource Brush.Accent.Light}" CornerRadius="1" Margin="1,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 4: ACTIVE PROJECTS & DEVELOPER ENVIRONMENT ==================== -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <!-- Left: Active Projects (1.45fr) -->
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="18" />
                    <!-- Right: Developer Environment (1fr) -->
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Active Projects -->
                <Border Grid.Column="0" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Fill="{DynamicResource Brush.Accent.Light}"
                                      Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Active Projects"
                                               Style="{StaticResource Style.Text.Title}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Running and configured projects on this machine."
                                               Style="{StaticResource Style.Text.Caption}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="View All &#x2192;"
                                    Style="{StaticResource Style.Button.Link}"
                                    Command="{Binding ViewAllProjectsCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Project Rows List -->
                        <Grid Grid.Row="2">
                            <!-- Empty state placeholder when no active projects exist -->
                            <Border Background="{DynamicResource Brush.Background.CardSubtle}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24,28"
                                    HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveProjects}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Muted}"
                                          Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                          HorizontalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBlock Text="No registered projects found."
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               FontSize="13.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Use 'Add Project' or 'Detect Project' in Quick Actions to register projects."
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               FontSize="11.5" Margin="0,3,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Dynamic Active Projects List -->
                            <ItemsControl ItemsSource="{Binding ActiveProjects}">
                                <ItemsControl.Style>
                                    <Style TargetType="{x:Type ItemsControl}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveProjects}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DashboardProjectItem}">
                                        <Border Background="{DynamicResource Brush.Background.CardSubtle}"
                                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,12"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Icon Badge -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- Info + Tags (Project Identity) -->
                                                    <ColumnDefinition Width="*" MinWidth="110" />
                                                    <!-- Status & Port -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!-- Action Buttons -->
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon Badge -->
                                                <Border Grid.Column="0"
                                                        Width="36" Height="36"
                                                        CornerRadius="8"
                                                        Background="#22183C"
                                                        BorderBrush="#442E78"
                                                        BorderThickness="1"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <!-- DotNet badge -->
                                                        <TextBlock Text=".NET"
                                                                   FontWeight="Bold"
                                                                   FontSize="11"
                                                                   Foreground="#C084FC"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IconKind}" Value="DotNet">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Next.js badge -->
                                                        <TextBlock Text="N"
                                                                   FontWeight="Bold"
                                                                   FontSize="18"
                                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IconKind}" Value="Next">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- Vite badge -->
                                                        <Path Width="18" Height="18" Stretch="Uniform"
                                                              Fill="#FBBF24"
                                                              Data="M7 2v11h3v9l7-12h-4l3-8z">
                                                            <Path.Style>
                                                                <Style TargetType="{x:Type Path}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IconKind}" Value="Vite">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>

                                                        <!-- Generic Folder badge -->
                                                        <Path Width="16" Height="16" Stretch="Uniform"
                                                              Fill="{DynamicResource Brush.Text.Secondary}"
                                                              Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z">
                                                            <Path.Style>
                                                                <Style TargetType="{x:Type Path}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IconKind}" Value="Folder">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                </Border>

                                                <!-- Name, Path, Tags -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Path}"
                                                               Style="{StaticResource Style.Text.Caption}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                                               Margin="0,1,0,4"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" ClipToBounds="True">
                                                        <Border Style="{StaticResource Style.Border.TagPill}" Background="{DynamicResource Brush.Tag.Blue.Bg}">
                                                            <TextBlock Text="{Binding FrameworkBadge}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Tag.Blue.Text}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Style.Border.TagPill}" Background="{DynamicResource Brush.Tag.Slate.Bg}" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding CategoryBadge}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Tag.Slate.Text}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Status & Port -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,10,0">
                                                    <Border HorizontalAlignment="Left" Margin="0,0,0,3">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Style.Border.StatusBadge.Stopped}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Status.Success.Bg}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Success.Border}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Margin="0,0,4,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="{x:Type Ellipse}" BasedOn="{StaticResource Style.Ellipse.StatusDot.Danger}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Medium">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="{x:Type TextBlock}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Success}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding PortText}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource Brush.Accent.Light}"
                                                               HorizontalAlignment="Left" />
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource Style.Button.Action}" Padding="7,4" Height="27" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.OpenProjectCommand, ElementName=DashboardRoot}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Secondary}" Margin="0,0,4,0"
                                                                  Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                                                            <TextBlock Text="Open" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource Style.Button.Action}" Padding="7,4" Height="27" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.ViewLogsCommand, ElementName=DashboardRoot}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Secondary}" Margin="0,0,4,0"
                                                                  Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                                                            <TextBlock Text="View Logs" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- Stop Button (Visible when IsRunning) -->
                                                    <Button Padding="7,4" Height="27" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.StopProjectCommand, ElementName=DashboardRoot}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Style.Button.DangerOutline}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="7" Height="7" Fill="{DynamicResource Brush.Button.Danger.Text}" Margin="0,0,4,0" RadiusX="1" RadiusY="1" />
                                                            <TextBlock Text="Stop" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- Run Button (Visible when NOT IsRunning) -->
                                                    <Button Padding="7,4" Height="27" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.RunProjectCommand, ElementName=DashboardRoot}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Style.Button.RunAction}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Width="9" Height="9" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Primary}" Margin="0,0,4,0" Data="M8 5v14l11-7z" />
                                                            <TextBlock Text="Run" FontSize="11.5" />
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- Overflow Button -->
                                                    <Button Style="{StaticResource Style.Button.IconGhost}" Width="24" Height="27"
                                                            Tag="{Binding DataContext, ElementName=DashboardRoot}"
                                                            CommandParameter="{Binding}"
                                                            Click="OnOverflowButtonClick">
                                                        <TextBlock Text="&#x22EE;" FontSize="14" Foreground="{DynamicResource Brush.Text.Muted}" />
                                                        <Button.ContextMenu>
                                                            <ContextMenu Style="{StaticResource Style.ContextMenu.Dark}">
                                                                <MenuItem Header="Open in VS Code"
                                                                          Style="{StaticResource Style.MenuItem.Dark}"
                                                                          Command="{Binding PlacementTarget.Tag.OpenVsCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="Open in Explorer"
                                                                          Style="{StaticResource Style.MenuItem.Dark}"
                                                                          Command="{Binding PlacementTarget.Tag.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="Open Terminal"
                                                                          Style="{StaticResource Style.MenuItem.Dark}"
                                                                          Command="{Binding PlacementTarget.Tag.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <Separator />
                                                                <MenuItem Header="View Logs"
                                                                          Style="{StaticResource Style.MenuItem.Dark}"
                                                                          Command="{Binding PlacementTarget.Tag.ViewLogsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Panel: Developer Environment -->
                <Border Grid.Column="2" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Fill="{DynamicResource Brush.Accent.Light}"
                                      Data="M4 9h4v11H4zm6-5h4v16h-4zm6 8h4v8h-4z"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Developer Environment"
                                           Style="{StaticResource Style.Text.Title}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Quick summary of your development environment."
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- 2x2 Environment Metrics Grid -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1: Active Projects -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Style.Border.CardInner}" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zm0 3v7h16V9H4z"
                                          Margin="0,2,8,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding EnvironmentSummary[0].Title, FallbackValue='Active Projects'}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding EnvironmentSummary[0].Value, FallbackValue='0'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding EnvironmentSummary[0].Subtext, FallbackValue='of 0 total'}" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2: Active Dev Ports -->
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Style.Border.CardInner}" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M18 16c-.79 0-1.5.31-2.03.81L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.05 4.12c-.05.22-.09.45-.09.69 0 1.66 1.34 3 3 3s3-1.34 3-3-1.34-3-3-3z"
                                          Margin="0,2,8,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding EnvironmentSummary[1].Title, FallbackValue='Active Dev Ports'}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding EnvironmentSummary[1].Value, FallbackValue='0'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding EnvironmentSummary[1].Subtext, FallbackValue='open and in use'}" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3: Git Changes -->
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Style.Border.CardInner}" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Status.Success}"
                                          Data="M18 16c-.79 0-1.5.31-2.03.81L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.05 4.12c-.05.22-.09.45-.09.69 0 1.66 1.34 3 3 3s3-1.34 3-3-1.34-3-3-3z"
                                          Margin="0,2,8,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding EnvironmentSummary[2].Title, FallbackValue='Git Changes'}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding EnvironmentSummary[2].Value, FallbackValue='—'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding EnvironmentSummary[2].Subtext, FallbackValue='status'}" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 4: Port Conflicts -->
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Style.Border.CardInner}" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Status.Danger}"
                                          Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                                          Margin="0,2,8,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding EnvironmentSummary[3].Title, FallbackValue='Port Conflicts'}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding EnvironmentSummary[3].Value, FallbackValue='0'}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding EnvironmentSummary[3].Subtext, FallbackValue='all clear'}" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 6: RECENT PROJECTS & QUICK ACTIONS ==================== -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <!-- Left: Recent Projects (1.45fr) -->
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="18" />
                    <!-- Right: Quick Actions (1fr) -->
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Recent Projects -->
                <Border Grid.Column="0" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Fill="{DynamicResource Brush.Accent.Light}"
                                      Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Recent Projects"
                                               Style="{StaticResource Style.Text.Title}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Your recently opened projects."
                                               Style="{StaticResource Style.Text.Caption}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Clear History"
                                    Style="{StaticResource Style.Button.Link}"
                                    Command="{Binding ClearHistoryCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Recent Rows List -->
                        <Grid Grid.Row="2">
                            <ItemsControl ItemsSource="{Binding RecentProjects}">
                                <ItemsControl.Style>
                                    <Style TargetType="{x:Type ItemsControl}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecentProjects}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DashboardRecentProjectItem}">
                                        <Grid Margin="0,5,0,8" Background="Transparent" Cursor="Hand">
                                            <Grid.InputBindings>
                                                <MouseBinding Gesture="LeftClick"
                                                              Command="{Binding DataContext.OpenProjectCommand, ElementName=DashboardRoot}"
                                                              CommandParameter="{Binding}" />
                                            </Grid.InputBindings>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="5" Background="#182334" Margin="0,0,10,0">
                                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Secondary}"
                                                      Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" FontSize="13.5" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding LastOpenedText}" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="14,0,14,0" />
                                            <Ellipse Grid.Column="4" Width="8" Height="8" Fill="{DynamicResource Brush.Status.Success}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Grid.Column="5" Style="{StaticResource Style.Button.IconGhost}"
                                                    Tag="{Binding DataContext, ElementName=DashboardRoot}"
                                                    CommandParameter="{Binding}"
                                                    Click="OnOverflowButtonClick">
                                                <TextBlock Text="&#x22EE;" FontSize="14" Foreground="{DynamicResource Brush.Text.Muted}" />
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource Style.ContextMenu.Dark}">
                                                        <MenuItem Header="Open in VS Code"
                                                                  Style="{StaticResource Style.MenuItem.Dark}"
                                                                  Command="{Binding PlacementTarget.Tag.OpenVsCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Open in Explorer"
                                                                  Style="{StaticResource Style.MenuItem.Dark}"
                                                                  Command="{Binding PlacementTarget.Tag.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Open Terminal"
                                                                  Style="{StaticResource Style.MenuItem.Dark}"
                                                                  Command="{Binding PlacementTarget.Tag.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Separator />
                                                        <MenuItem Header="View Logs"
                                                                  Style="{StaticResource Style.MenuItem.Dark}"
                                                                  Command="{Binding PlacementTarget.Tag.ViewLogsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.CommandParameter, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state placeholder when history is cleared -->
                            <TextBlock Text="No recent projects."
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,20">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecentProjects}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Panel: Quick Actions -->
                <Border Grid.Column="2" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Fill="{DynamicResource Brush.Accent.Light}"
                                      Data="M7 2v11h3v9l7-12h-4l3-8z"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Quick Actions"
                                           Style="{StaticResource Style.Text.Title}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Common tasks to boost your productivity."
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- 2x2 Quick Action Tiles -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tile 1: Add Project -->
                            <Button Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource Style.Button.QuickActionTile}"
                                    Command="{Binding AddProjectCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Add Project" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="Manually add a project folder" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Tile 2: Detect Project -->
                            <Button Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource Style.Button.QuickActionTile}"
                                    Command="{Binding DetectProjectCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Detect Project" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="Scan for development projects" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Tile 3: Open VS Code -->
                            <Button Grid.Row="2" Grid.Column="0"
                                    Style="{StaticResource Style.Button.QuickActionTile}"
                                    Command="{Binding OpenVsCodeCommand}"
                                    IsEnabled="{Binding CanOpenVsCode}"
                                    ToolTip="{Binding VsCodeTooltip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M18.5 2.5L14 6.7 6.4 1.1 2 4.4v15.2l4.4 3.3 7.6-5.6 4.5 4.2 3.5-1.7V4.2l-3.5-1.7z"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Open VS Code" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="Open current workspace" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Tile 4: Check Ports -->
                            <Button Grid.Row="2" Grid.Column="2"
                                    Style="{StaticResource Style.Button.QuickActionTile}"
                                    Command="{Binding CheckPortsCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="20" Height="20" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M18 16c-.79 0-1.5.31-2.03.81L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.05 4.12c-.05.22-.09.45-.09.69 0 1.66 1.34 3 3 3s3-1.34 3-3-1.34-3-3-3z"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Check Ports" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="Scan for port conflicts" FontSize="10.5" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
