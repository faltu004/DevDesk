<Window x:Class="DevDesk.App.Views.Commands.ConfirmDeleteCommandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Commands"
        d:DataContext="{d:DesignInstance Type=vm:ConfirmDeleteCommandViewModel}"
        mc:Ignorable="d"
        Title="Delete Command"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Root}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Border Padding="24" Background="{DynamicResource Brush.Background.Card}">
        <StackPanel>
            <!-- Header with Danger Icon -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="38" Height="38" CornerRadius="8"
                        Background="{DynamicResource Brush.Status.Danger.Bg}"
                        BorderBrush="{DynamicResource Brush.Status.Danger.Border}"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Path Width="18" Height="18" Stretch="Uniform"
                          Fill="{DynamicResource Brush.Status.Danger}"
                          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Delete Saved Command"
                               Style="{StaticResource Style.Text.Title}"
                               FontSize="16"
                               FontWeight="Bold" />
                    <TextBlock Text="This permanently deletes the saved command definition from DevDesk."
                               Style="{StaticResource Style.Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Command Preview Box -->
            <Border Background="{DynamicResource Brush.Background.CardSubtle}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding CommandName}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="{Binding ExecutableAndArgs}"
                               Style="{StaticResource Style.Text.Caption}"
                               FontFamily="{StaticResource FontFamily.Monospace}"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Style.Button.Action}"
                        Margin="0,0,8,0"
                        Height="34"
                        Padding="16,0" />

                <Button Grid.Column="2"
                        Content="Delete Command"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource Style.Button.DangerOutline}"
                        Height="34"
                        Padding="16,0" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
