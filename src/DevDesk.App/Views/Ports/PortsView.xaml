<UserControl x:Class="DevDesk.App.Views.Ports.PortsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Ports"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:PortsViewModel}"
             d:DesignHeight="900" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Table Row Item Container Style -->
        <Style x:Key="Style.ListBoxItem.PortRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush.Background.CardHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Outer Padding matching Dashboard/Projects layout -->
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <!-- 0: Header & Search Bar -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <!-- 1: Notification / Alert Banner (if any) -->
            <RowDefinition Height="Auto" />
            <!-- 2: Top 4 Metric Summary Cards -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <!-- 3: Main Listening Ports Table Card -->
            <RowDefinition Height="*" MinHeight="260" />
            <!-- 4: Spacing & Conflict Detail Banner -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 0: HEADER & SEARCH ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource Style.Text.Header}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding Subtitle}"
                           Style="{StaticResource Style.Text.Caption}"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Search Bar -->
            <Border Grid.Column="1"
                    Style="{StaticResource Style.Border.Card}"
                    Background="{DynamicResource Brush.Background.Input}"
                    BorderBrush="{DynamicResource Brush.Border.Medium}"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Width="13" Height="13"
                          Stretch="Uniform"
                          Fill="{DynamicResource Brush.Text.Muted}"
                          Margin="0,0,10,0"
                          Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />

                    <Grid Grid.Column="1">
                        <TextBlock Text="{Binding SearchPlaceholder}"
                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Style.Text.Body}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="PortsSearchTextBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderThickness="0"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource Brush.Text.Primary}" />
                    </Grid>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Brush.Background.NavActive}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="5,1"
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding SearchShortcut}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 1: NOTIFICATION BANNERS ==================== -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <!-- Error Banner -->
            <Border Background="#331A1A"
                    BorderBrush="{DynamicResource Brush.Status.Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠" FontSize="14" Foreground="{DynamicResource Brush.Status.Danger}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="12.5" Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Command="{Binding DismissNotificationCommand}" Style="{StaticResource Style.Button.IconGhost}" Width="20" Height="20" Padding="0">
                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- Warning Banner (Partial inspection) -->
            <Border Background="#332B1A"
                    BorderBrush="{DynamicResource Brush.Status.Warning}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WarningMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding WarningMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ℹ" FontSize="14" Foreground="{DynamicResource Brush.Status.Warning}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding WarningMessage}" FontSize="12.5" Foreground="{DynamicResource Brush.Status.Warning}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Command="{Binding DismissNotificationCommand}" Style="{StaticResource Style.Button.IconGhost}" Width="20" Height="20" Padding="0">
                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ==================== 2: TOP 4 METRIC SUMMARY CARDS ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Active Listening Ports -->
            <Border Grid.Column="0" Style="{StaticResource Style.Border.Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Header with icon -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Border Width="28" Height="28" CornerRadius="6" Background="#162A43" Margin="0,0,8,0">
                            <TextBlock Text="🔌" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Listening Ports" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Value & Graphic -->
                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding TotalListeningPortsCount}" Style="{StaticResource Style.Text.Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Light}" VerticalAlignment="Center" />
                        <!-- Decorative mini sparkline indicator -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="20">
                            <Rectangle Width="3" Height="8" Fill="{DynamicResource Brush.Accent.Primary}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="14" Fill="{DynamicResource Brush.Accent.Primary}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="11" Fill="{DynamicResource Brush.Accent.Primary}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="18" Fill="{DynamicResource Brush.Accent.Primary}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="15" Fill="{DynamicResource Brush.Accent.Primary}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="active TCP listeners" Style="{StaticResource Style.Text.Caption}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- Card 2: Potential Conflicts -->
            <Border Grid.Column="2" Style="{StaticResource Style.Border.Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Border Width="28" Height="28" CornerRadius="6" Background="#381E1E" Margin="0,0,8,0">
                            <TextBlock Text="⚠" FontSize="13" Foreground="{DynamicResource Brush.Status.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Potential Conflicts" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding PotentialConflictsCount}" Style="{StaticResource Style.Text.Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Danger}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="20">
                            <Rectangle Width="3" Height="6" Fill="{DynamicResource Brush.Status.Danger}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="12" Fill="{DynamicResource Brush.Status.Danger}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="18" Fill="{DynamicResource Brush.Status.Danger}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="9" Fill="{DynamicResource Brush.Status.Danger}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="project ports in use" Style="{StaticResource Style.Text.Caption}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- Card 3: Configured Project Ports -->
            <Border Grid.Column="4" Style="{StaticResource Style.Border.Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Border Width="28" Height="28" CornerRadius="6" Background="#162A43" Margin="0,0,8,0">
                            <TextBlock Text="📁" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Configured Ports" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding ConfiguredProjectPortsCount}" Style="{StaticResource Style.Text.Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Light}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="20">
                            <Rectangle Width="3" Height="10" Fill="{DynamicResource Brush.Accent.Primary}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="16" Fill="{DynamicResource Brush.Accent.Primary}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="12" Fill="{DynamicResource Brush.Accent.Primary}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="14" Fill="{DynamicResource Brush.Accent.Primary}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="projects with ports" Style="{StaticResource Style.Text.Caption}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- Card 4: Free Configured Ports -->
            <Border Grid.Column="6" Style="{StaticResource Style.Border.Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Border Width="28" Height="28" CornerRadius="6" Background="#132E27" Margin="0,0,8,0">
                            <TextBlock Text="🟢" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Free Configured Ports" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding FreeConfiguredPortsCount}" Style="{StaticResource Style.Text.Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Success}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="20">
                            <Rectangle Width="3" Height="14" Fill="{DynamicResource Brush.Status.Success}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="18" Fill="{DynamicResource Brush.Status.Success}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="12" Fill="{DynamicResource Brush.Status.Success}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="16" Fill="{DynamicResource Brush.Status.Success}" Margin="1,0" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="configured project ports currently free" Style="{StaticResource Style.Text.Caption}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3: MAIN LISTENING PORTS CARD ==================== -->
        <Border Grid.Row="3" Style="{StaticResource Style.Border.Card}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header Bar (Title + Refresh Button) -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <!-- Column Header Row -->
                    <RowDefinition Height="Auto" />
                    <!-- Scrollable Ports List / Empty State -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.Background.NavActive}" Margin="0,0,10,0">
                            <TextBlock Text="🔌" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Listening Ports" Style="{StaticResource Style.Text.Title}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="All active listening ports on your machine." Style="{StaticResource Style.Text.Caption}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Refresh Button -->
                    <Button Grid.Column="1"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource Style.Button.Action}"
                            Height="32"
                            Padding="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="↻" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Column Header Row -->
                <Border Grid.Row="2"
                        Background="Transparent"
                        Padding="14,8"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.0*" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="2.4*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Port ⇅" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Grid.Column="1" Text="Protocol ⇅" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Grid.Column="2" Text="Process ⇅" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Grid.Column="3" Text="PID ⇅" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Grid.Column="4" Text="Project ⇅" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Grid.Column="5" Text="Local Address ⇅" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Grid.Column="6" Text="State ⇅" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                    </Grid>
                </Border>

                <!-- Scrollable Table Content -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- Populated ListBox -->
                        <ListBox ItemsSource="{Binding FilteredPorts}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FocusVisualStyle="{x:Null}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource Style.ListBoxItem.PortRow}">
                            <ListBox.Style>
                                <Style TargetType="{x:Type ListBox}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFilteredPorts}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PortItemPresentationModel}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="1.0*" />
                                            <ColumnDefinition Width="1.8*" />
                                            <ColumnDefinition Width="2.4*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 0: Port Number (Bold, Tinted Red on Conflict) -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding PortDisplay}"
                                                   FontSize="13"
                                                   FontFamily="{StaticResource FontFamily.Monospace}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Light}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 1: Protocol (TCP Pill) -->
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource Brush.Background.Input}"
                                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Protocol}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        </Border>

                                        <!-- 2: Process (Avatar + Name) -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource Brush.Background.NavActive}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ProcessInitials}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Light}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding ProcessName}" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessName}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- 3: PID -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ProcessIdDisplay}"
                                                   FontFamily="{StaticResource FontFamily.Monospace}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   VerticalAlignment="Center" />

                                        <!-- 4: Project -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding ProjectDisplay}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ProjectDisplay}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasConfiguredProjects}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                                            <Setter Property="FontWeight" Value="Medium" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 5: Local Address -->
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding LocalAddress}"
                                                   FontFamily="{StaticResource FontFamily.Monospace}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding LocalAddress}"
                                                   VerticalAlignment="Center" />

                                        <!-- 6: State Pill (Listening vs In Use) -->
                                        <Border Grid.Column="6" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="#132E27" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                            <Setter Property="Background" Value="#381E1E" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="{x:Type Ellipse}">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Status.Success}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Status.Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StateDisplay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Success}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty Filter Results State -->
                        <Border Padding="32" Margin="0,24,0,0">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFilteredPorts}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔌" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="No listening ports match your filter" Style="{StaticResource Style.Text.Title}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Try clearing or adjusting your search term." Style="{StaticResource Style.Text.Caption}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ==================== 4: CONFLICT DETAIL BANNER ==================== -->
        <Border Grid.Row="4" Margin="0,16,0,0">
            <Grid>
                <!-- When Potential Conflicts Exist -->
                <Border Background="#1F1517"
                        BorderBrush="#4D2226"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPotentialConflicts}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid DataContext="{Binding SelectedConflict}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header: Warning Icon + Title + Pill -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#381E1E" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="⚠" FontSize="18" Foreground="{DynamicResource Brush.Status.Danger}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Style.Text.Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Style.Text.Caption}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="#381E1E" BorderBrush="{DynamicResource Brush.Status.Danger}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="Potential Conflict" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Danger}" />
                            </Border>
                        </Grid>

                        <!-- Details Row: Process, PID, Local Address, Affected Project -->
                        <Border Grid.Row="2" Background="#140E10" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.3*" />
                                </Grid.ColumnDefinitions>

                                <!-- Process Name -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PROCESS NAME" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProcessName}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding AdditionalOccupantsText}" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1" Height="24" Fill="{DynamicResource Brush.Border.Subtle}" Margin="12,0" VerticalAlignment="Center" />

                                <!-- PID -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PID" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding ProcessIdDisplay}" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>

                                <Rectangle Grid.Column="3" Width="1" Height="24" Fill="{DynamicResource Brush.Border.Subtle}" Margin="12,0" VerticalAlignment="Center" />

                                <!-- Local Address -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="LOCAL ADDRESS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding LocalAddress}" FontFamily="{StaticResource FontFamily.Monospace}" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>

                                <Rectangle Grid.Column="5" Width="1" Height="24" Fill="{DynamicResource Brush.Border.Subtle}" Margin="12,0" VerticalAlignment="Center" />

                                <!-- Affected Project(s) -->
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="AFFECTED PROJECT(S)" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding AffectedProjectsDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Light}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AffectedProjectsDisplay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- When No Conflicts Exist -->
                <Border Background="#12241D"
                        BorderBrush="#1D4A3A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPotentialConflicts}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.Success}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="No Port Conflicts Detected" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Status.Success}" />
                            <TextBlock Text="All configured project default ports are currently free." FontSize="11.5" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
