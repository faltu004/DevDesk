<UserControl x:Class="DevDesk.App.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Dashboard"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="880" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,24,30,28">
            <Grid.RowDefinitions>
                <!-- 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- 1: Spacing -->
                <RowDefinition Height="20" />
                <!-- 2: System Metrics Row -->
                <RowDefinition Height="Auto" />
                <!-- 3: Spacing -->
                <RowDefinition Height="20" />
                <!-- 4: Active Projects & Dev Environment Row -->
                <RowDefinition Height="Auto" />
                <!-- 5: Spacing -->
                <RowDefinition Height="20" />
                <!-- 6: Recent Projects & Quick Actions Row -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== 0: HEADER SECTION ==================== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource Style.Text.Header}"
                               FontSize="27"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle}"
                               Style="{StaticResource Style.Text.Subtitle}"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Right: Search / Quick Action Visual Field -->
                <Border Grid.Column="1"
                        Style="{StaticResource Style.Border.Search}"
                        Width="370"
                        Height="38"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon -->
                        <Path Grid.Column="0"
                              Width="14" Height="14"
                              Stretch="Uniform"
                              Fill="{DynamicResource Brush.Text.Muted}"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />

                        <!-- Placeholder Text -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SearchPlaceholder}"
                                   Style="{StaticResource Style.Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Ctrl + K Badge -->
                        <Border Grid.Column="2"
                                Style="{StaticResource Style.Border.ShortcutBadge}">
                            <TextBlock Text="{Binding SearchShortcut}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 2: SYSTEM METRICS ROW ==================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Metric 1: CPU -->
                <Border Grid.Column="0" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Icon + Title -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="7"
                                        Background="#102744"
                                        BorderBrush="#1D436C"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M4 6h2v2H4zm0 5h2v2H4zm0 5h2v2H4zm14-10h2v2h-2zm0 5h2v2h-2zm0 5h2v2h-2zM6 4h2v2H6zm5 0h2v2h-2zm5 0h2v2h-2zM6 18h2v2H6zm5 0h2v2h-2zm5 0h2v2h-2zM7 7h10v10H7z" />
                                </Border>
                                <TextBlock Text="CPU"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   Text="28%"
                                   Style="{StaticResource Style.Text.Header}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,10,0,6" />

                        <!-- Subtext + Sparkline Curve -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="3.4 / 12 Cores"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center" />
                            <!-- Smooth Wave Sparkline -->
                            <Polyline Points="0,14 8,11 16,16 24,7 32,10 40,4 48,9 56,2"
                                      Stroke="{DynamicResource Brush.Accent.Light}"
                                      StrokeThickness="1.75"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Width="56" Height="18" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Metric 2: RAM -->
                <Border Grid.Column="2" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Icon + Title -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="7"
                                        Background="#0A2922"
                                        BorderBrush="#155144"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Teal}"
                                          Data="M4 7h16v10H4zm2 2v6h2V9zm4 0v6h2V9zm4 0v6h2V9z" />
                                </Border>
                                <TextBlock Text="RAM"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   Text="9.2 / 16 GB"
                                   Style="{StaticResource Style.Text.Header}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,10,0,6" />

                        <!-- Subtext + Progress Bar -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="57% in use"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center" />
                            <!-- Mini Gauge Bar -->
                            <Border Width="76" Height="6" CornerRadius="3"
                                    Background="{DynamicResource Brush.Background.Input}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <Border Width="43" Height="6" CornerRadius="3"
                                        Background="{DynamicResource Brush.Status.Success}"
                                        HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Metric 3: Disk -->
                <Border Grid.Column="4" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Icon + Title -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="7"
                                        Background="#182334"
                                        BorderBrush="#293952"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                          Data="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zm14 7a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" />
                                </Border>
                                <TextBlock Text="Disk"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   Text="68%"
                                   Style="{StaticResource Style.Text.Header}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Margin="0,10,0,6" />

                        <!-- Subtext + Progress Bar -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="326 / 476 GB"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center" />
                            <!-- Mini Gauge Bar -->
                            <Border Width="76" Height="6" CornerRadius="3"
                                    Background="{DynamicResource Brush.Background.Input}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <Border Width="52" Height="6" CornerRadius="3"
                                        Background="{DynamicResource Brush.Status.Warning}"
                                        HorizontalAlignment="Left" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Metric 4: Network -->
                <Border Grid.Column="6" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Icon + Title -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="7"
                                        Background="#102744"
                                        BorderBrush="#1D436C"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98C20.93 5.9 16.69 4 12 4zm0 3.5c3.67 0 7.02 1.4 9.53 3.73l-2.07 2.08C17.47 11.66 14.86 10.5 12 10.5s-5.47 1.16-7.46 2.81L2.47 11.23C4.98 8.9 8.33 7.5 12 7.5z" />
                                </Border>
                                <TextBlock Text="Network"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Value -->
                        <TextBlock Grid.Row="1"
                                   Text="12 Mbps"
                                   Style="{StaticResource Style.Text.Header}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,10,0,6" />

                        <!-- Subtext + Histogram Bars -->
                        <Grid Grid.Row="2">
                            <TextBlock Text="&#x2193; 8.4 Mbps   &#x2191; 3.6 Mbps"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       VerticalAlignment="Center" />
                            <!-- Mini Histogram -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom">
                                <Border Width="3.5" Height="6" Background="{DynamicResource Brush.Accent.Light}" CornerRadius="1" Margin="1,0" />
                                <Border Width="3.5" Height="12" Background="{DynamicResource Brush.Accent.Light}" CornerRadius="1" Margin="1,0" />
                                <Border Width="3.5" Height="18" Background="{DynamicResource Brush.Accent.Light}" CornerRadius="1" Margin="1,0" />
                                <Border Width="3.5" Height="13" Background="{DynamicResource Brush.Accent.Light}" CornerRadius="1" Margin="1,0" />
                                <Border Width="3.5" Height="16" Background="{DynamicResource Brush.Accent.Light}" CornerRadius="1" Margin="1,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== 4: ACTIVE PROJECTS & DEVELOPER ENVIRONMENT ==================== -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <!-- Left: Active Projects (1.45fr) -->
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="18" />
                    <!-- Right: Developer Environment (1fr) -->
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Active Projects -->
                <Border Grid.Column="0" Style="{StaticResource Style.Border.Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Fill="{DynamicResource Brush.Accent.Light}"
                                      Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Active Projects"
                                               Style="{StaticResource Style.Text.Title}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Running and configured projects on this machine."
                                               Style="{StaticResource Style.Text.Caption}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="View All &#x2192;"
                                    Style="{StaticResource Style.Button.Link}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Project Rows List -->
                        <StackPanel Grid.Row="2">
                            <!-- Row 1: Portfolio -->
                            <Border Background="{DynamicResource Brush.Background.CardSubtle}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,12"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Icon Badge -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Info + Tags -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Status & Port -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Action Buttons -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Vite Icon Badge -->
                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="8"
                                            Background="#22183C"
                                            BorderBrush="#442E78"
                                            BorderThickness="1"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <Path Width="18" Height="18" Stretch="Uniform"
                                              Fill="#FBBF24"
                                              Data="M7 2v11h3v9l7-12h-4l3-8z" />
                                    </Border>

                                    <!-- Name, Path, Tags -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Portfolio"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="C:\Dev\portfolio"
                                                   Style="{StaticResource Style.Text.Caption}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   Margin="0,1,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Style.Border.TagPill}" Background="{DynamicResource Brush.Tag.Blue.Bg}">
                                                <TextBlock Text="Vite" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Tag.Blue.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Style.Border.TagPill}" Background="{DynamicResource Brush.Tag.Slate.Bg}">
                                                <TextBlock Text="Frontend" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Tag.Slate.Text}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status & Port -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0">
                                        <Border Style="{StaticResource Style.Border.StatusBadge.Running}" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource Style.Ellipse.StatusDot}" Margin="0,0,5,0" />
                                                <TextBlock Text="Running" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Status.Success}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Port 5173"
                                                   FontSize="12.5"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.Accent.Light}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Style.Button.Action}" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Secondary}" Margin="0,0,5,0"
                                                      Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                                                <TextBlock Text="Open" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Style.Button.Action}" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Secondary}" Margin="0,0,5,0"
                                                      Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                                                <TextBlock Text="View Logs" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Style.Button.DangerOutline}" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="8" Height="8" Fill="{DynamicResource Brush.Button.Danger.Text}" Margin="0,0,5,0" RadiusX="1" RadiusY="1" />
                                                <TextBlock Text="Stop" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Style.Button.IconGhost}">
                                            <TextBlock Text="&#x22EE;" FontSize="15" Foreground="{DynamicResource Brush.Text.Muted}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 2: DevAI Toolkit -->
                            <Border Background="{DynamicResource Brush.Background.CardSubtle}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,12"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Next.js Icon Badge -->
                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="8"
                                            Background="#141C2B"
                                            BorderBrush="#263650"
                                            BorderThickness="1"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="N"
                                                   FontWeight="Bold"
                                                   FontSize="17"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Name, Path, Tags -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="DevAI Toolkit"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="C:\Dev\devai-toolkit"
                                                   Style="{StaticResource Style.Text.Caption}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   Margin="0,1,0,4" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Style.Border.TagPill}" Background="{DynamicResource Brush.Tag.Dark.Bg}">
                                                <TextBlock Text="Next.js" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Tag.Dark.Text}" />
                                            </Border>
                                            <Border Style="{StaticResource Style.Border.TagPill}" Background="{DynamicResource Brush.Tag.Slate.Bg}">
                                                <TextBlock Text="Full Stack" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Tag.Slate.Text}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status & Port -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0">
                                        <Border Style="{StaticResource Style.Border.StatusBadge.Running}" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource Style.Ellipse.StatusDot}" Margin="0,0,5,0" />
                                                <TextBlock Text="Running" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource Brush.Status.Success}" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Port 3000"
                                                   FontSize="12.5"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.Accent.Light}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Style.Button.Action}" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Secondary}" Margin="0,0,5,0"
                                                      Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                                                <TextBlock Text="Open" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Style.Button.Action}" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Secondary}" Margin="0,0,5,0"
                                                      Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
                                                <TextBlock Text="View Logs" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Style.Button.DangerOutline}" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="8" Height="8" Fill="{DynamicResource Brush.Button.Danger.Text}" Margin="0,0,5,0" RadiusX="1" RadiusY="1" />
                                                <TextBlock Text="Stop" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Style.Button.IconGhost}">
                                            <TextBlock Text="&#x22EE;" FontSize="15" Foreground="{DynamicResource Brush.Text.Muted}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 3: API Server -->
                            <Border Background="{DynamicResource Brush.Background.CardSubtle}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
