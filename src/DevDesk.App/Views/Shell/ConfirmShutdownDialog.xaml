<Window x:Class="DevDesk.App.Views.Shell.ConfirmShutdownDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Shell"
        d:DataContext="{d:DesignInstance Type=vm:ConfirmShutdownViewModel}"
        mc:Ignorable="d"
        Title="Active Projects Running - DevDesk"
        Width="490"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Root}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Border Padding="24" Background="{DynamicResource Brush.Background.Card}">
        <StackPanel>
            <!-- Header with Warning / Danger Icon -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="40" Height="40" CornerRadius="8"
                        Background="{DynamicResource Brush.Status.Danger.Bg}"
                        BorderBrush="{DynamicResource Brush.Status.Danger.Border}"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Path Width="18" Height="18" Stretch="Uniform"
                          Fill="{DynamicResource Brush.Status.Danger}"
                          Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Active Projects Running"
                               Style="{StaticResource Style.Text.Title}"
                               FontSize="16"
                               FontWeight="Bold" />
                    <TextBlock Text="DevDesk is managing active project sessions."
                               Style="{StaticResource Style.Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Message Box -->
            <Border Background="{DynamicResource Brush.Background.CardSubtle}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,18">
                <TextBlock Text="{Binding Message}"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           TextWrapping="Wrap"
                           LineHeight="19" />
            </Border>

            <!-- Explanation Note -->
            <Border Background="#122538"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Fill="{DynamicResource Brush.Accent.Light}"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
                    <TextBlock Text="Redirected output pipes and process sessions are tied to DevDesk."
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Style.Button.Action}"
                        Margin="0,0,10,0"
                        Height="34"
                        Padding="16,0" />

                <Button Grid.Column="2"
                        Content="Stop Projects &amp; Exit"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource Style.Button.DangerOutline}"
                        Height="34"
                        Padding="16,0" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
