<Window x:Class="DevDesk.App.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Shell"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Height="820" Width="1340"
        MinHeight="660" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background.Root}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Column -->
            <ColumnDefinition Width="250" />
            <!-- Main Content Area Column -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR SHELL ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Background.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,20">
                <Grid.RowDefinitions>
                    <!-- Brand / App Header -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <!-- Navigation Menu -->
                    <RowDefinition Height="*" />
                    <!-- Status / System Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Grid Grid.Row="0" Margin="2,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Stylized DevDesk 3D Cube Logo Icon -->
                    <Border Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="{DynamicResource Brush.Background.NavActive}"
                            BorderBrush="{DynamicResource Brush.Border.Medium}"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                        <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Left Face -->
                            <Path Data="M11,2 L2,7 L2,15 L11,20 Z"
                                  Fill="{DynamicResource Brush.Accent.Primary}" />
                            <!-- Right Face -->
                            <Path Data="M11,2 L20,7 L20,15 L11,20 Z"
                                  Fill="{DynamicResource Brush.Accent.Light}"
                                  Opacity="0.88" />
                            <!-- Top Highlight Edge -->
                            <Path Data="M11,2 L2,7 L11,11 L20,7 Z"
                                  Fill="#5EEAD4"
                                  Opacity="0.65" />
                        </Canvas>
                    </Border>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DevDesk"
                                   Style="{StaticResource Style.Text.Title}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   LineHeight="22" />
                        <TextBlock Text="Windows Developer&#x0a;Control Center"
                                   Style="{StaticResource Style.Text.Caption}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Navigation Menu Links -->
                <StackPanel Grid.Row="2" Margin="0,4,0,0">
                    <!-- Dashboard Nav (Active) -->
                    <RadioButton Style="{StaticResource Style.Button.Nav}"
                                 IsChecked="{Binding IsDashboardSelected, Mode=OneWay}"
                                 Command="{Binding NavigateToDashboardCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10,20v-6h4v6h5v-8h3L12,3 2,12h3v8z"
                                  Margin="0,0,14,0" />
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Projects Nav (Disabled in Foundation Phase) -->
                    <RadioButton Style="{StaticResource Style.Button.Nav}"
                                 IsEnabled="False"
                                 ToolTip="Available in Projects phase">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                  Margin="0,0,14,0" />
                            <TextBlock Text="Projects" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Processes Nav (Disabled in Foundation Phase) -->
                    <RadioButton Style="{StaticResource Style.Button.Nav}"
                                 IsEnabled="False"
                                 ToolTip="Available in Processes phase">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM7.5 13.5l2-3 2 3 3.5-5.5"
                                  Margin="0,0,14,0" />
                            <TextBlock Text="Processes" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Ports Nav (Disabled in Foundation Phase) -->
                    <RadioButton Style="{StaticResource Style.Button.Nav}"
                                 IsEnabled="False"
                                 ToolTip="Available in Ports phase">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M18 16c-.79 0-1.5.31-2.03.81L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.05 4.12c-.05.22-.09.45-.09.69 0 1.66 1.34 3 3 3s3-1.34 3-3-1.34-3-3-3z"
                                  Margin="0,0,14,0" />
                            <TextBlock Text="Ports" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Commands Nav (Disabled in Foundation Phase) -->
                    <RadioButton Style="{StaticResource Style.Button.Nav}"
                                 IsEnabled="False"
                                 ToolTip="Available in Commands phase">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zm-12-3l4-3-4-3v2H6v2h2v2zm6 0h4v-2h-4v2z"
                                  Margin="0,0,14,0" />
                            <TextBlock Text="Commands" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Settings Nav (Disabled in Foundation Phase) -->
                    <RadioButton Style="{StaticResource Style.Button.Nav}"
                                 IsEnabled="False"
                                 Margin="0,18,0,0"
                                 ToolTip="Available in Settings phase">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                  Margin="0,0,14,0" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Sidebar Footer (System Status) -->
                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Padding="4,16,4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{StaticResource Style.Ellipse.StatusDot}" />
                            <TextBlock Text="{Binding SystemStatus}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SystemVersion}"
                                   Style="{StaticResource Style.Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Margin="16,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT HOST ==================== -->
        <Border Grid.Column="1"
                Background="{DynamicResource Brush.Background.Main}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl Grid.Row="0"
                                Content="{Binding CurrentViewModel}"
                                Focusable="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />

                <!-- Bottom Right Brand Subtext -->
                <TextBlock Grid.Row="1"
                           Text="Build &#x2022; Develop &#x2022; Ship"
                           Style="{StaticResource Style.Text.Caption}"
                           Foreground="#475569"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           Margin="0,0,32,16" />
            </Grid>
        </Border>
    </Grid>
</Window>
