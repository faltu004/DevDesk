<Window x:Class="DevDesk.App.Views.Projects.AddEditProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Projects"
        d:DataContext="{d:DesignInstance Type=vm:AddEditProjectViewModel}"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Root}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Border Padding="24" Background="{DynamicResource Brush.Background.Card}">
        <StackPanel>
            <!-- Dialog Header -->
            <TextBlock Text="{Binding DialogTitle}"
                       Style="{StaticResource Style.Text.Title}"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Configure project properties and default commands for DevDesk."
                       Style="{StaticResource Style.Text.Caption}"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,0,20" />

            <!-- Error Banner -->
            <Border Background="{DynamicResource Brush.Status.Danger.Bg}"
                    BorderBrush="{DynamicResource Brush.Status.Danger.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,16">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource Style.Ellipse.StatusDot.Danger}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Brush.Status.Danger}"
                               FontSize="12"
                               FontWeight="Medium"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Project Path -->
            <TextBlock Text="Project Directory Path"
                       Style="{StaticResource Style.Text.Caption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,0,6" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource Brush.Background.Input}"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         BorderBrush="{DynamicResource Brush.Border.Subtle}"
                         BorderThickness="1"
                         Padding="10,8"
                         FontSize="12.5"
                         FontFamily="{StaticResource FontFamily.Monospace}"
                         VerticalContentAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Browse..."
                        Command="{Binding BrowsePathCommand}"
                        Style="{StaticResource Style.Button.Action}"
                        Margin="8,0,0,0"
                        Height="34"
                        Padding="12,0" />
            </Grid>

            <!-- Project Name -->
            <TextBlock Text="Project Name *"
                       Style="{StaticResource Style.Text.Caption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource Brush.Background.Input}"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     BorderBrush="{DynamicResource Brush.Border.Subtle}"
                     BorderThickness="1"
                     Padding="10,8"
                     FontSize="13"
                     Margin="0,0,0,16"
                     VerticalContentAlignment="Center" />

            <!-- Default Port -->
            <TextBlock Text="Default Port (optional, 1 - 65535)"
                       Style="{StaticResource Style.Text.Caption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource Brush.Background.Input}"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     BorderBrush="{DynamicResource Brush.Border.Subtle}"
                     BorderThickness="1"
                     Padding="10,8"
                     FontSize="12.5"
                     FontFamily="{StaticResource FontFamily.Monospace}"
                     Margin="0,0,0,16"
                     VerticalContentAlignment="Center" />

            <!-- Run Command -->
            <TextBlock Text="Run Command (optional, e.g. npm run dev, dotnet run)"
                       Style="{StaticResource Style.Text.Caption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding RunCommand, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource Brush.Background.Input}"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     BorderBrush="{DynamicResource Brush.Border.Subtle}"
                     BorderThickness="1"
                     Padding="10,8"
                     FontSize="12.5"
                     FontFamily="{StaticResource FontFamily.Monospace}"
                     Margin="0,0,0,16"
                     VerticalContentAlignment="Center" />

            <!-- Build Command -->
            <TextBlock Text="Build Command (optional, e.g. npm run build, dotnet build)"
                       Style="{StaticResource Style.Text.Caption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding BuildCommand, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource Brush.Background.Input}"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     BorderBrush="{DynamicResource Brush.Border.Subtle}"
                     BorderThickness="1"
                     Padding="10,8"
                     FontSize="12.5"
                     FontFamily="{StaticResource FontFamily.Monospace}"
                     Margin="0,0,0,16"
                     VerticalContentAlignment="Center" />

            <!-- Test Command -->
            <TextBlock Text="Test Command (optional, e.g. npm test, dotnet test)"
                       Style="{StaticResource Style.Text.Caption}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding TestCommand, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource Brush.Background.Input}"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     BorderBrush="{DynamicResource Brush.Border.Subtle}"
                     BorderThickness="1"
                     Padding="10,8"
                     FontSize="12.5"
                     FontFamily="{StaticResource FontFamily.Monospace}"
                     Margin="0,0,0,24"
                     VerticalContentAlignment="Center" />

            <!-- Dialog Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Style.Button.Action}"
                        Margin="0,0,10,0"
                        Height="34"
                        Padding="16,0" />

                <Button Grid.Column="2"
                        Content="Save Project"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource Style.Button.Primary}"
                        Height="34"
                        Padding="18,0" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
