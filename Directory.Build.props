<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>DevDesk</Product>
    <Title>DevDesk — Windows Developer Control Center</Title>
    <Description>Local-first Windows developer control center for managing projects, processes, ports, Git status, saved commands, and system telemetry.</Description>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>
</Project>
