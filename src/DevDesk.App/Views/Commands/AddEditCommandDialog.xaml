<Window x:Class="DevDesk.App.Views.Commands.AddEditCommandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Commands"
        d:DataContext="{d:DesignInstance Type=vm:AddEditCommandViewModel}"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Width="580"
        Height="620"
        MinHeight="440"
        MinWidth="500"
        MaxHeight="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background.Root}"
        Foreground="{DynamicResource Brush.Text.Primary}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Padding="24,20,24,18" Background="{DynamicResource Brush.Background.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Scrollable Form Content -->
                <RowDefinition Height="*" />
                <!-- Row 1: Fixed Footer (never hidden, never cut) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: FORM CONTENT ==================== -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Padding="0,0,10,0">
                <StackPanel Margin="0,0,4,0">
                    <!-- Dialog Header -->
                    <TextBlock Text="{Binding DialogTitle}"
                               Style="{StaticResource Style.Text.Title}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Configure developer command properties, arguments, and execution location."
                               Style="{StaticResource Style.Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,0,16" />

                    <!-- Error Banner -->
                    <Border Background="{DynamicResource Brush.Status.Danger.Bg}"
                            BorderBrush="{DynamicResource Brush.Status.Danger.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,14"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource Style.Ellipse.StatusDot.Danger}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource Brush.Status.Danger}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Scope Selection -->
                    <TextBlock Text="Command Scope"
                               Style="{StaticResource Style.Text.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton Content="Project-Scoped"
                                     IsChecked="{Binding IsProjectScope, Mode=TwoWay}"
                                     Style="{StaticResource Style.RadioButton.Dark}"
                                     GroupName="CommandScope"
                                     Margin="0,0,24,0" />
                        <RadioButton Content="Global"
                                     IsChecked="{Binding IsGlobalScope, Mode=TwoWay}"
                                     Style="{StaticResource Style.RadioButton.Dark}"
                                     GroupName="CommandScope" />
                    </StackPanel>

                    <!-- Associated Project (Visible if Project-Scoped) -->
                    <StackPanel Visibility="{Binding IsProjectScope, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                        <TextBlock Text="Associated Project *"
                                   Style="{StaticResource Style.Text.Caption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableProjects}"
                                  SelectedItem="{Binding SelectedProject}"
                                  Style="{StaticResource Style.ComboBox.Dark}"
                                  Height="34">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Command Name -->
                    <TextBlock Text="Command Name *"
                               Style="{StaticResource Style.Text.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource Brush.Background.Input}"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             BorderBrush="{DynamicResource Brush.Border.Subtle}"
                             BorderThickness="1"
                             Padding="10,8"
                             FontSize="13"
                             Margin="0,0,0,14" />

                    <!-- Description -->
                    <TextBlock Text="Description (optional)"
                               Style="{StaticResource Style.Text.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource Brush.Background.Input}"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             BorderBrush="{DynamicResource Brush.Border.Subtle}"
                             BorderThickness="1"
                             Padding="10,8"
                             FontSize="12.5"
                             Margin="0,0,0,14" />

                    <!-- Executable -->
                    <TextBlock Text="Executable Tool or Path *"
                               Style="{StaticResource Style.Text.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Brush.Background.Input}"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 FontSize="12.5"
                                 FontFamily="{StaticResource FontFamily.Monospace}" />
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Command="{Binding BrowseExecutableCommand}"
                                Style="{StaticResource Style.Button.Action}"
                                Margin="8,0,0,0"
                                Height="34"
                                Padding="12,0" />
                    </Grid>

                    <!-- Arguments -->
                    <TextBlock Text="Arguments"
                               Style="{StaticResource Style.Text.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding ArgumentsText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource Brush.Background.Input}"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             BorderBrush="{DynamicResource Brush.Border.Subtle}"
                             BorderThickness="1"
                             Padding="10,8"
                             FontSize="12.5"
                             FontFamily="{StaticResource FontFamily.Monospace}"
                             Margin="0,0,0,10" />

                    <!-- Structured Argument Badges Preview -->
                    <Border Background="{DynamicResource Brush.Background.CardSubtle}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Structured Argument Tokens Preview:"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding ParsedArgumentsTokens}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E293B"
                                                BorderBrush="{DynamicResource Brush.Border.Medium}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{StaticResource FontFamily.Monospace}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.Accent.Light}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Working Directory -->
                    <TextBlock Text="Working Directory (optional override)"
                               Style="{StaticResource Style.Text.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource Brush.Background.Input}"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 FontSize="12"
                                 FontFamily="{StaticResource FontFamily.Monospace}" />
                        <Button Grid.Column="1"
                                Content="Browse..."
                                Command="{Binding BrowseDirectoryCommand}"
                                Style="{StaticResource Style.Button.Action}"
                                Margin="8,0,0,0"
                                Height="34"
                                Padding="12,0" />
                    </Grid>

                    <TextBlock Text="{Binding ResolvedWorkingDirectoryPreview, StringFormat='Resolved Directory: {0}'}"
                               Style="{StaticResource Style.Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               FontSize="11"
                               Margin="2,0,0,14" />

                    <!-- Category & Enabled -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Category / Tag"
                                       Style="{StaticResource Style.Text.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource Brush.Background.Input}"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                     BorderThickness="1"
                                     Padding="10,8"
                                     FontSize="12.5" />
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  Content="Enabled"
                                  IsChecked="{Binding IsEnabled}"
                                  Style="{StaticResource Style.CheckBox.Dark}"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,8" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== ROW 1: FIXED FOOTER ==================== -->
            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    Padding="0,14,0,0"
                    Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource Style.Button.Action}"
                            Margin="0,0,10,0"
                            Height="34"
                            Padding="16,0" />

                    <Button Grid.Column="2"
                            Content="Save Command"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource Style.Button.Primary}"
                            Height="34"
                            Padding="20,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
