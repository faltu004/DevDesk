<UserControl x:Class="DevDesk.App.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Dashboard"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource Style.Text.Header}"
                           FontSize="26"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding Subtitle}"
                           Style="{StaticResource Style.Text.Subtitle}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Foundation Content Card / Placeholder Section -->
            <Grid Grid.Row="2">
                <Border Style="{StaticResource Style.Border.Card}"
                        MinHeight="360"
                        VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="32">
                        <!-- Foundation Icon / Indicator -->
                        <Border Width="64"
                                Height="64"
                                CornerRadius="16"
                                Background="{DynamicResource Brush.Background.NavActive}"
                                BorderBrush="{DynamicResource Brush.Border.Medium}"
                                BorderThickness="1"
                                Margin="0,0,0,18"
                                HorizontalAlignment="Center">
                            <Path Width="28"
                                  Height="28"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource Brush.Accent.Light}"
                                  Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" />
                        </Border>

                        <TextBlock Text="DevDesk Shell Ready"
                                   Style="{StaticResource Style.Text.Title}"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="The MVVM application host, dependency injection, and navigation foundation are active."
                                   Style="{StaticResource Style.Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="480"
                                   Margin="0,0,0,16" />

                        <Border Background="{DynamicResource Brush.Background.Root}"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Style.Ellipse.StatusDot}" />
                                <TextBlock Text="Initial Dashboard View Loaded"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
