<UserControl x:Class="DevDesk.App.Views.Projects.ProjectLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Projects"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Controls Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Virtualized Logs Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 0: CONTROLS TOOLBAR ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Background.CardSubtle}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Session Selector & Stream Filter -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <!-- Right: Search & Actions -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Group -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Session Selector Dropdown -->
                    <ComboBox ItemsSource="{Binding RecentSessions}"
                              SelectedItem="{Binding SelectedSession}"
                              Style="{StaticResource Style.ComboBox.Dark}"
                              Width="180"
                              Height="28"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding State}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding FormattedStartedAt}" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Stream Filter Segment -->
                    <Border Background="{DynamicResource Brush.Background.Input}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="All"
                                         GroupName="StreamFilterGroup"
                                         IsChecked="{Binding IsFilterAll}"
                                         Style="{StaticResource Style.RadioButton.FilterSegment}" />
                            <RadioButton Content="stdout"
                                         GroupName="StreamFilterGroup"
                                         IsChecked="{Binding IsFilterStdout}"
                                         Style="{StaticResource Style.RadioButton.FilterSegment}" />
                            <RadioButton Content="stderr"
                                         GroupName="StreamFilterGroup"
                                         IsChecked="{Binding IsFilterStderr}"
                                         Style="{StaticResource Style.RadioButton.FilterSegment}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Group: Search, Clear View, Copy -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Input Box -->
                    <Border Background="{DynamicResource Brush.Background.Input}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Width="180"
                            Height="28"
                            Margin="0,0,8,0"
                            Padding="6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Width="11" Height="11"
                                  Stretch="Uniform"
                                  Fill="{DynamicResource Brush.Text.Muted}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     BorderThickness="0"
                                     FontSize="11.5"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Grid.Column="1"
                                       Text="Filter logs..."
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FilterText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Clear View Button (Watermark presentation-only) -->
                    <Button Command="{Binding ClearViewCommand}"
                            Style="{StaticResource Style.Button.Action}"
                            Height="28"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            ToolTip="Hides output prior to this point. Runner log buffer remains intact.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊘" FontSize="11" Margin="0,-1,5,0" />
                            <TextBlock Text="Clear View" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <!-- Copy All Visible Button -->
                    <Button Command="{Binding CopyAllVisibleCommand}"
                            Style="{StaticResource Style.Button.Action}"
                            Height="28"
                            Padding="10,0"
                            ToolTip="Copy all currently visible log lines to clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="11" Margin="0,-1,5,0" />
                            <TextBlock Text="Copy" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 1: VIRTUALIZED LOGS LIST ==================== -->
        <Grid Grid.Row="1">
            <Border Background="{DynamicResource Brush.Background.Input}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="6">
                <!-- Virtualized ListBox: NO external ScrollViewer -->
                <ListBox x:Name="LogsListBox"
                         ItemsSource="{Binding VisibleLogs}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6,4"
                         SelectionMode="Extended"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy Selected Line(s)"
                                      Command="{Binding CopySelectedLogsCommand}"
                                      CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItems}" />
                            <MenuItem Header="Copy All Visible Logs"
                                      Command="{Binding CopyAllVisibleCommand}" />
                            <Separator />
                            <MenuItem Header="Clear View"
                                      Command="{Binding ClearViewCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Padding" Value="4,1" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="20" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                CornerRadius="2"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#152338" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LogLineItem}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <!-- Timestamp -->
                                    <ColumnDefinition Width="80" />
                                    <!-- Stream badge -->
                                    <ColumnDefinition Width="52" />
                                    <!-- Text Content (Auto width prevents clipping and enables horizontal scroll) -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Timestamp -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FormattedTimestamp}"
                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,6,0" />

                                <!-- Stream Badge -->
                                <Border Grid.Column="1"
                                        CornerRadius="3"
                                        Padding="4,0"
                                        Height="16"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="#0A291A" />
                                            <Setter Property="BorderBrush" Value="#165330" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Background" Value="#2C1116" />
                                                    <Setter Property="BorderBrush" Value="#581C24" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StreamBadge}"
                                               FontFamily="{StaticResource FontFamily.Monospace}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Text -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Text}"
                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                           FontSize="11.5"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="#F87171" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLogs}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text=">_"
                           FontFamily="{StaticResource FontFamily.Monospace}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="No output received for this session."
                           FontSize="12.5"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Smart Auto-Scroll Indicator Button -->
            <Button Command="{Binding ScrollToBottomCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,20,18"
                    Height="30"
                    Padding="12,0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Style.Button.Primary}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUnseenLogs}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="New logs" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,4,0" />
                    <Border Background="#162A43" CornerRadius="8" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="{Binding UnseenLogsCount}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Light}" />
                    </Border>
                    <TextBlock Text="↓" FontSize="12" FontWeight="Bold" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
