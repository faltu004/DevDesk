<UserControl x:Class="DevDesk.App.Views.Projects.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DevDesk.App.ViewModels.Projects"
             d:DataContext="{d:DesignInstance Type=vm:ProjectsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="880" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- ListBoxItem Style for Project Row -->
        <Style x:Key="Style.ListBoxItem.ProjectRow" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.CardSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Brush.Background.CardHover}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Medium}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource Brush.Background.NavActive}" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Active}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <!-- 0: Header Row -->
            <RowDefinition Height="Auto" />
            <!-- 1: Spacing -->
            <RowDefinition Height="18" />
            <!-- 2: Error Notification Banner -->
            <RowDefinition Height="Auto" />
            <!-- 3: Main Split Content (List + Details) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 0: HEADER SECTION ==================== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource Style.Text.Header}"
                           FontSize="26"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding Subtitle}"
                           Style="{StaticResource Style.Text.Subtitle}"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Right: Search Bar & Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Search Input Field -->
                <Border Style="{StaticResource Style.Border.Search}"
                        Width="340"
                        Height="36"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon -->
                        <Path Grid.Column="0"
                              Width="13" Height="13"
                              Stretch="Uniform"
                              Fill="{DynamicResource Brush.Text.Muted}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />

                        <!-- Search TextBox -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 BorderThickness="0"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{DynamicResource Brush.Text.Primary}" />

                        <!-- Placeholder Text when empty -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SearchPlaceholder}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Shortcut Badge -->
                        <Border Grid.Column="2"
                                Style="{StaticResource Style.Border.ShortcutBadge}">
                            <TextBlock Text="{Binding SearchShortcut}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- + Add Project Button -->
                <Button Command="{Binding AddProjectCommand}"
                        Style="{StaticResource Style.Button.Primary}"
                        Height="36"
                        Padding="14,0"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="+" FontWeight="Bold" FontSize="15" Margin="0,-1,6,0" />
                        <TextBlock Text="Add Project" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Detect Project Button (Reserved for Phase 4) -->
                <Button Style="{StaticResource Style.Button.Action}"
                        IsEnabled="False"
                        ToolTip="Project auto-detection will be available in Phase 4"
                        Height="36"
                        Padding="12,0"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="12" Height="12" Stretch="Uniform"
                              Fill="{DynamicResource Brush.Text.Disabled}"
                              Margin="0,0,6,0"
                              Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                        <TextBlock Text="Detect Project" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Refresh Button -->
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource Style.Button.IconGhost}"
                        Width="36" Height="36"
                        ToolTip="Refresh Projects List">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Fill="{DynamicResource Brush.Text.Secondary}"
                          Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 2: ERROR NOTIFICATION BANNER ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Status.Danger.Bg}"
                BorderBrush="{DynamicResource Brush.Status.Danger.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource Style.Ellipse.StatusDot.Danger}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Brush.Status.Danger}"
                               FontSize="12.5"
                               FontWeight="Medium" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 3: MAIN SPLIT WORKSPACE ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Left: Projects List & Table (~68%) -->
                <ColumnDefinition Width="1.95*" />
                <ColumnDefinition Width="20" />
                <!-- Right: Selected Project Details Panel (~32%) -->
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT WORKSPACE: Projects List & Filters -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Filter and Sort Bar -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <!-- Table Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Project Rows Scrollable List / Empty State -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter & Status Bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Filter Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- All Projects Count Badge -->
                        <Border Background="{DynamicResource Brush.Background.NavActive}"
                                BorderBrush="{DynamicResource Brush.Border.Active}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="All Projects"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           Margin="0,0,8,0" />
                                <Border Background="#162A43" CornerRadius="10" Padding="6,1">
                                    <TextBlock Text="{Binding TotalCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Light}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Rectangle Width="1" Height="18" Fill="{DynamicResource Brush.Border.Subtle}" Margin="0,0,14,0" VerticalAlignment="Center" />

                        <TextBlock Text="Sort by: Recency"
                                   Style="{StaticResource Style.Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Table Header Row -->
                <Border Grid.Row="2"
                        Background="Transparent"
                        Padding="14,8"
                        Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Project (Name / Path) -->
                            <ColumnDefinition Width="2.8*" />
                            <!-- Framework -->
                            <ColumnDefinition Width="1.1*" />
                            <!-- Language / PM -->
                            <ColumnDefinition Width="1.1*" />
                            <!-- Default Port -->
                            <ColumnDefinition Width="0.85*" />
                            <!-- Last Opened -->
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Project &#x21D5;" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Grid.Column="1" Text="Framework" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Grid.Column="2" Text="Language / PM" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Grid.Column="3" Text="Default Port" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Grid.Column="4" Text="Last Opened &#x21D5;" Style="{StaticResource Style.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Muted}" />
                    </Grid>
                </Border>

                <!-- Project Rows List -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- Populated ListBox with Styled Items -->
                        <ListBox ItemsSource="{Binding FilteredProjects}"
                                 SelectedItem="{Binding SelectedProject}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource Style.ListBoxItem.ProjectRow}">
                            <ListBox.Style>
                                <Style TargetType="{x:Type ListBox}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFilteredProjects}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProjectPresentationModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Project (Avatar + Name + Path) -->
                                            <ColumnDefinition Width="2.8*" />
                                            <!-- Framework -->
                                            <ColumnDefinition Width="1.1*" />
                                            <!-- Language / PM -->
                                            <ColumnDefinition Width="1.1*" />
                                            <!-- Default Port -->
                                            <ColumnDefinition Width="0.85*" />
                                            <!-- Last Opened -->
                                            <ColumnDefinition Width="1.15*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 0: Project Info Column -->
                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Project Initials Avatar -->
                                            <Border Grid.Column="0"
                                                    Width="34" Height="34"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource Brush.Background.NavActive}"
                                                    BorderBrush="{DynamicResource Brush.Border.Medium}"
                                                    BorderThickness="1"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontWeight="Bold"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource Brush.Accent.Light}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Name & Path -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13.5"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Path}"
                                                           Style="{StaticResource Style.Text.Caption}"
                                                           FontFamily="{StaticResource FontFamily.Monospace}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 1: Framework -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FrameworkDisplay}"
                                                   Style="{StaticResource Style.Text.Body}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   VerticalAlignment="Center" />

                                        <!-- 2: Language / PM -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LanguageDisplay}"
                                                       Style="{StaticResource Style.Text.Body}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <Border Background="{DynamicResource Brush.Background.Input}"
                                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Style.Border.TagPill}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPackageManager}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding PackageManagerDisplay}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource Brush.Text.Muted}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- 3: Default Port (Persisted Config) -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding PortDisplay}"
                                                   FontFamily="{StaticResource FontFamily.Monospace}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   VerticalAlignment="Center" />

                                        <!-- 4: Last Opened -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding LastOpenedDisplay}"
                                                   Style="{StaticResource Style.Text.Caption}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State View -->
                        <Border Padding="40,48"
                                Margin="0,20,0,0">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Style.Border.Card}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFilteredProjects}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Folder Icon -->
                                <Border Width="56" Height="56" CornerRadius="12"
                                        Background="{DynamicResource Brush.Background.NavActive}"
                                        BorderBrush="{DynamicResource Brush.Border.Medium}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,16">
                                    <Path Width="26" Height="26" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Accent.Light}"
                                          Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                                </Border>

                                <TextBlock Text="No projects yet"
                                           Style="{StaticResource Style.Text.Title}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6" />

                                <TextBlock Text="Add your local project directories to configure commands, ports, and manage them from DevDesk."
                                           Style="{StaticResource Style.Text.Caption}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           TextAlignment="Center"
                                           MaxWidth="420"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,20" />

                                <Button Command="{Binding AddProjectCommand}"
                                        Style="{StaticResource Style.Button.Primary}"
                                        Height="36"
                                        Padding="18,0"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontWeight="Bold" FontSize="15" Margin="0,-1,6,0" />
                                        <TextBlock Text="Add Project" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- RIGHT WORKSPACE: Selected Project Details Panel -->
            <Border Grid.Column="2" Style="{StaticResource Style.Border.Card}" Padding="18,16">
                <Grid>
                    <!-- Detail Content when SelectedProject is present -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="{x:Type ScrollViewer}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel DataContext="{Binding SelectedProject}">
                            <!-- Header: Icon + Name + Path -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon Avatar -->
                                <Border Grid.Column="0"
                                        Width="40" Height="40"
                                        CornerRadius="8"
                                        Background="{DynamicResource Brush.Background.NavActive}"
                                        BorderBrush="{DynamicResource Brush.Border.Medium}"
                                        BorderThickness="1"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initials}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{DynamicResource Brush.Accent.Light}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Title & Path -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource Style.Text.Title}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}"
                                               Style="{StaticResource Style.Text.Caption}"
                                               FontFamily="{StaticResource FontFamily.Monospace}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Tab Bar (Overview / Scripts / Environment / Notes) -->
                            <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Overview Tab (Active) -->
                                    <Border BorderBrush="{DynamicResource Brush.Accent.Primary}" BorderThickness="0,0,0,2" Padding="8,6" Margin="0,0,12,0">
                                        <TextBlock Text="Overview" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Primary}" />
                                    </Border>
                                    <Border Padding="8,6" Margin="0,0,12,0">
                                        <TextBlock Text="Scripts" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                    </Border>
                                    <Border Padding="8,6" Margin="0,0,12,0">
                                        <TextBlock Text="Environment" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                    </Border>
                                    <Border Padding="8,6">
                                        <TextBlock Text="Notes" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Key Command Fields (Path, Run, Build, Test) with Copy Buttons -->
                            <StackPanel Margin="0,0,0,12">
                                <!-- Project Path -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📁 Path" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Width="105" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="11.5" FontFamily="{StaticResource FontFamily.Monospace}" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Path}"
                                            Style="{StaticResource Style.Button.IconGhost}"
                                            Width="22" Height="22" ToolTip="Copy Path">
                                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Muted}"
                                              Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
                                    </Button>
                                </Grid>

                                <!-- Run Command -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text=">_ Run Command" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Width="105" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding RunCommandDisplay}" FontSize="11.5" FontFamily="{StaticResource FontFamily.Monospace}" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding RunCommand}"
                                            Style="{StaticResource Style.Button.IconGhost}"
                                            Width="22" Height="22" ToolTip="Copy Run Command">
                                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Muted}"
                                              Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
                                    </Button>
                                </Grid>

                                <!-- Build Command -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚙ Build Command" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Width="105" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding BuildCommandDisplay}" FontSize="11.5" FontFamily="{StaticResource FontFamily.Monospace}" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding BuildCommand}"
                                            Style="{StaticResource Style.Button.IconGhost}"
                                            Width="22" Height="22" ToolTip="Copy Build Command">
                                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Muted}"
                                              Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
                                    </Button>
                                </Grid>

                                <!-- Test Command -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🧪 Test Command" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Width="105" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TestCommandDisplay}" FontSize="11.5" FontFamily="{StaticResource FontFamily.Monospace}" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding TestCommand}"
                                            Style="{StaticResource Style.Button.IconGhost}"
                                            Width="22" Height="22" ToolTip="Copy Test Command">
                                        <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Muted}"
                                              Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Separator Style="{StaticResource Style.Separator.Subtle}" Margin="0,6,0,12" />

                            <!-- Metadata Grid (Default Port, Framework, Package Manager, Last Opened) -->
                            <StackPanel Margin="0,0,0,14">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🔀 Default Port" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding PortDisplay}" FontSize="12" FontFamily="{StaticResource FontFamily.Monospace}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="🧩 Framework" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding FrameworkDisplay}" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="📦 Package Manager" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding PackageManagerDisplay}" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="🕒 Last Opened" FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding LastOpenedDisplay}" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>

                            <Separator Style="{StaticResource Style.Separator.Subtle}" Margin="0,0,0,14" />

                            <!-- Quick Actions Section -->
                            <TextBlock Text="⚙ Quick Actions" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Run (Disabled for Phase 3) -->
                                <Button Grid.Column="0"
                                        Style="{StaticResource Style.Button.RunAction}"
                                        IsEnabled="False"
                                        ToolTip="Execution runner will be available in Phase 7"
                                        Height="32" Padding="0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Disabled}" Margin="0,0,4,0" Data="M8 5v14l11-7z" />
                                        <TextBlock Text="Run" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                    </StackPanel>
                                </Button>

                                <!-- Stop (Disabled for Phase 3) -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource Style.Button.DangerOutline}"
                                        IsEnabled="False"
                                        ToolTip="Execution runner will be available in Phase 7"
                                        Height="32" Padding="0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Rectangle Width="7" Height="7" Fill="{DynamicResource Brush.Text.Disabled}" Margin="0,0,4,0" RadiusX="1" RadiusY="1" />
                                        <TextBlock Text="Stop" FontSize="11.5" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                    </StackPanel>
                                </Button>

                                <!-- VS Code (Disabled for Phase 3) -->
                                <Button Grid.Column="4"
                                        Style="{StaticResource Style.Button.Action}"
                                        IsEnabled="False"
                                        ToolTip="VS Code launcher will be available in Phase 5"
                                        Height="32" Padding="0">
                                    <TextBlock Text="VS Code" FontSize="11" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                </Button>

                                <!-- Explorer (Disabled for Phase 3) -->
                                <Button Grid.Column="6"
                                        Style="{StaticResource Style.Button.Action}"
                                        IsEnabled="False"
                                        ToolTip="Explorer launcher will be available in Phase 5"
                                        Height="32" Padding="0">
                                    <TextBlock Text="Explorer" FontSize="11" Foreground="{DynamicResource Brush.Text.Disabled}" />
                                </Button>
                            </Grid>

                            <!-- Edit Project & Remove Project Buttons -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Edit Project"
                                        Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource Style.Button.Action}"
                                        Height="32" />

                                <Button Grid.Column="2"
                                        Content="Remove"
                                        Command="{Binding DataContext.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource Style.Button.DangerOutline}"
                                        Height="32" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Placeholder when no project is selected -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Select a project"
                                   Style="{StaticResource Style.Text.Title}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Choose a workspace from the list to inspect details and commands."
                                   Style="{StaticResource Style.Text.Caption}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   TextAlignment="Center"
                                   MaxWidth="240"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
